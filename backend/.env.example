# Copy this file to `.env` and fill in your key. `.env` is gitignored.
# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Open-source model served by Groq used for document extraction.
GROQ_MODEL=llama-3.3-70b-versatile
# Optional: path to tesseract.exe if it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
