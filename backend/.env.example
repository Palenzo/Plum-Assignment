# Copy this file to `.env` and fill in a key. `.env` is gitignored.
#
# The app supports two LLM providers. It auto-detects: if OPENAI_API_KEY is set
# it uses OpenAI, otherwise Groq. Force one with LLM_PROVIDER=openai|groq.
# LLM_PROVIDER=openai

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Vision model for the OCR fallback (when Tesseract is absent). gpt-4o-mini can
# already read images, so this defaults to OPENAI_MODEL — override if you like.
# OPENAI_VISION_MODEL=gpt-4o-mini

# --- Groq (free key from https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Groq's default Llama is text-only, so the OCR fallback uses a Llama *vision*
# model. Override here if Groq changes the model id.
# GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Optional: path to tesseract.exe if it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
