# Copy this file to `.env` and fill in a key. `.env` is gitignored.
#
# The app supports two LLM providers. It auto-detects: if OPENAI_API_KEY is set
# it uses OpenAI, otherwise Groq. Force one with LLM_PROVIDER=openai|groq.
# LLM_PROVIDER=openai

# --- OpenAI (https://platform.openai.com/api-keys) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Groq (free key from https://console.groq.com/keys) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Optional: path to tesseract.exe if it is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
